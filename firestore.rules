rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Products: Anyone can read, only authenticated users can write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Orders: Authenticated users can read/write orders
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // 3. Addresses: Authenticated users can manage their own addresses
    match /addresses/{addressId} {
      allow read, write: if request.auth != null;
    }

    // 4. Notifications: Open read/write so all roles can receive real-time alerts
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 5. Wishlist: Authenticated users can manage their wishlist
    match /wishlist/{wishlistId} {
      allow read, write: if request.auth != null;
    }

    // 6. Coupons: Anyone can read; authenticated users can write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 7. Users: Authenticated users can read all; can write their own doc.
    //    Admin can write any user doc (used for delivery boy management).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 8. FCM Tokens: Authenticated users can read/write their own FCM token
    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null;
    }

    // 9. Videos: Anyone can read, only admin can write
    match /videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 10. Ratings: Anyone can read, only authenticated users can write
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
